frontend/style.css


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6f9;
    color: #222;
}


/* ================= HEADER ================= */

.header {
    min-height: 80px;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;

    background: #172554;
    color: white;
}

.header h1 {
    font-size: 26px;
}

.header p {
    margin-top: 5px;
    opacity: 0.8;
}


/* ================= BUTTONS ================= */

.dashboard-btn,
.home-btn,
.start-btn {
    text-decoration: none;
    color: white;
    background: #2563eb;

    padding: 12px 20px;
    border-radius: 8px;

    display: inline-block;

    font-weight: bold;
}

.dashboard-btn:hover,
.home-btn:hover,
.start-btn:hover {
    background: #1d4ed8;
}


/* ================= HERO ================= */

.hero {
    min-height: 400px;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 40px 20px;

    background: linear-gradient(
        135deg,
        #dbeafe,
        #eff6ff
    );
}

.hero-content {
    max-width: 750px;
}

.hero h2 {
    font-size: 42px;
    color: #172554;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    line-height: 1.7;
    color: #475569;
    margin-bottom: 30px;
}

.start-btn {
    font-size: 16px;
}


/* ================= FEATURES ================= */

.features {
    max-width: 1100px;
    margin: 50px auto;

    padding: 0 20px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 20px;
}

.feature-card {
    background: white;

    padding: 25px;

    border-radius: 12px;

    text-align: center;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.feature-card .icon {
    font-size: 38px;
    margin-bottom: 15px;
}

.feature-card h3 {
    margin-bottom: 10px;
    color: #172554;
}

.feature-card p {
    color: #64748b;
    line-height: 1.5;
}


/* ================= ABOUT ================= */

.about {
    background: white;

    padding: 45px 20px;

    text-align: center;
}

.about h2 {
    margin-bottom: 25px;
}

.technology-list {
    max-width: 900px;
    margin: auto;

    display: flex;
    justify-content: center;
    flex-wrap: wrap;

    gap: 12px;
}

.technology-list span {
    background: #e0e7ff;

    padding: 10px 18px;

    border-radius: 20px;

    color: #1e3a8a;

    font-weight: bold;
}


/* ================= FOOTER ================= */

footer {
    background: #172554;
    color: white;

    text-align: center;

    padding: 25px;

    margin-top: 30px;
}

footer p {
    margin: 5px;
}


/* ================= DASHBOARD HEADER ================= */

.dashboard-header {
    padding: 20px 7%;

    background: #172554;
    color: white;

    display: flex;

    justify-content: space-between;
    align-items: center;
}

.dashboard-header h1 {
    font-size: 28px;
}

.dashboard-header p {
    margin-top: 5px;
    opacity: 0.8;
}


/* ================= DASHBOARD ================= */

.dashboard-container {
    max-width: 1200px;

    margin: 30px auto;

    padding: 0 20px;
}


/* ================= SUMMARY CARDS ================= */

.summary-cards {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;
}

.summary-card {
    background: white;

    padding: 22px;

    border-radius: 12px;

    display: flex;

    align-items: center;

    gap: 18px;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.summary-icon {
    font-size: 38px;
}

.summary-card p {
    color: #64748b;
    margin-bottom: 8px;
}

.summary-card h2 {
    color: #172554;
    font-size: 23px;
}


/* ================= CHARTS ================= */

.chart-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;

    margin-top: 25px;
}

.chart-card {
    background: white;

    padding: 25px;

    border-radius: 12px;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.chart-card h2 {
    margin-bottom: 20px;
    color: #172554;
}

.chart-container {
    position: relative;

    height: 330px;
}


/* ================= TABLE ================= */

.table-card {
    background: white;

    padding: 25px;

    border-radius: 12px;

    margin-top: 25px;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.table-title h2 {
    color: #172554;
}

.table-title p {
    color: #64748b;
    margin-top: 5px;
    margin-bottom: 20px;
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;

    border-collapse: collapse;
}

th,
td {
    padding: 14px;

    text-align: left;

    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #f1f5f9;
    color: #172554;
}

tr:hover {
    background: #f8fafc;
}


/* ================= BIG DATA ================= */

.bigdata-info {
    background: white;

    margin-top: 25px;

    padding: 25px;

    border-radius: 12px;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.bigdata-info h2 {
    color: #172554;
    margin-bottom: 20px;
}

.bigdata-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 15px;
}

.bigdata-grid div {
    background: #eff6ff;

    padding: 20px;

    border-radius: 8px;

    text-align: center;
}

.bigdata-grid strong {
    color: #172554;
}

.bigdata-grid p {
    margin-top: 8px;
    color: #475569;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 900px) {

    .features,
    .summary-cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .chart-grid {
        grid-template-columns: 1fr;
    }

    .bigdata-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


@media (max-width: 600px) {

    .header,
    .dashboard-header {
        flex-direction: column;

        gap: 15px;

        text-align: center;
    }

    .features,
    .summary-cards,
    .bigdata-grid {
        grid-template-columns: 1fr;
    }

    .hero h2 {
        font-size: 30px;
    }

    .dashboard-header h1 {
        font-size: 22px;
    }
}